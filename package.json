{
  "name": "gridmaster",
  "version": "0.0.0",
  "private": true,
  "workspaces": ["packages/gridmaster-react"],
  "scripts": {
    "build": "npm run build -w gridmaster-react",
    "build:demo": "npm run build:demo -w gridmaster-react",
    "lab": "npm run lab -w gridmaster-react",
    "test": "npm test -w gridmaster-react",
    "typecheck": "npm run typecheck -w gridmaster-react",
    "lint": "biome lint .",
    "format:check": "biome format .",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4"
  },
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "npm@10.9.0"
}
